# ==============================================================================
# Fidelo E-Bike Store Inventory System - Environment Configuration Template
# Copy this file to '.env' for local Docker Compose execution.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (MySQL 8)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ebikestore_db
MYSQL_USER=ebikestore_user
MYSQL_PASSWORD=ebikestore1234
MYSQL_ROOT_PASSWORD=ebikestore1234
PHPMYADMIN_PORT=8080

# Backend Configuration
BACKEND_PORT=5000
NODE_ENV=development
SEED_TEST_DATA=true
STARTUP_RETRY_ATTEMPTS=10
STARTUP_RETRY_DELAY_SECONDS=5

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_INACTIVITY_TIMEOUT_MINUTES=30

# Security & Authentication Configuration
JWT_SECRET=ebikestore_staging_jwt_secret_key_2026
JWT_EXPIRE=24h
PII_ENCRYPTION_KEY=4623511cacc4489aa02a22356e54ffbeaa47bc4ff6d2254ec7fad87a17cf83a8

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Brevo Email Verification Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=noreply@fideloebike.store
BREVO_FROM_NAME="Fidelo E-Bike Store"


# Initial System Administrator Credentials (For seedAdmin script)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1234

# MinIO Object Storage Configuration (Product Images)
MINIO_ROOT_USER=ebikestore
MINIO_ROOT_PASSWORD=ebikestore1234
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ebikestore-products
MINIO_USE_SSL=false
